rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 出店者画像（exhibitorsフォルダ）
    match /exhibitors/{allPaths=**} {
      // 画像は誰でも閲覧可能
      allow read: if true;

      // 画像のアップロード・削除は管理者のみ許可
      allow write: if request.auth != null && request.auth.token.email == 'healthymarket2013@gmail.com';
    }
  }
}
